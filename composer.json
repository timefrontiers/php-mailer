{
  "name": "timefrontiers/php-mailer",
  "description": "Email sending, templating, mailing lists, and delivery queuing for the TimeFrontiers ecosystem",
  "keywords": ["php", "timefrontiers", "mailer", "email", "mailgun", "smtp", "template", "mailing-list"],
  "homepage": "https://github.com/timefrontiers/php-mailer",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Ikechukwu Okalia",
      "email": "consult@ikechukwuokalia.dev",
      "homepage": "https://ikechukwuokalia.dev",
      "role": "developer"
    },
    {
      "name": "Time Frontiers Ltd",
      "email": "git@timefrontiers.com",
      "homepage": "https://git.timefrontiers.com",
      "role": "developer"
    }
  ],
  "require": {
    "php": ">=8.5",
    "timefrontiers/php-data": "^1.0",
    "timefrontiers/php-core": "^1.0",
    "timefrontiers/php-sql-database": "^1.1",
    "timefrontiers/php-database-object": "^1.1.1",
    "timefrontiers/php-pagination": "^1.0",
    "timefrontiers/php-has-errors": "^1.0",
    "timefrontiers/php-validator": "^1.1",
    "timefrontiers/php-file": "^1.1",
    "symfony/mailer": "^7.0",
    "symfony/mailgun-mailer": "^7.0",
    "symfony/http-client": "^7.0",
    "league/commonmark": "^2.5"
  },
  "require-dev": {
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5"
  },
  "suggest": {
    "timefrontiers/php-instance-error": "Optional consumer-side rank-aware extraction of canonical HasErrors data"
  },
  "autoload": {
    "psr-4": {
      "TimeFrontiers\\Mailer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TimeFrontiers\\Mailer\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
    "check": [
      "@lint",
      "@test",
      "@analyse"
    ],
    "lint": "@php vendor/bin/parallel-lint src tests",
    "test": "@php vendor/bin/phpunit --configuration=phpunit.xml.dist",
    "test-integration": "@php vendor/bin/phpunit --configuration=phpunit.xml.dist --testsuite Integration",
    "test-unit": "@php vendor/bin/phpunit --configuration=phpunit.xml.dist --testsuite Unit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
